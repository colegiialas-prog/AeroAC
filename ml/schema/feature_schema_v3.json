  "derivations": {
    "targetAngularVelocityYaw": "wrap180(TARGET_YAW[t] - TARGET_YAW[t-1]) when sameTarget(t)",
    "targetAngularVelocityPitch": "TARGET_PITCH[t] - TARGET_PITCH[t-1] when sameTarget(t)",
    "rotationTargetAlignment": "cos angle between (DELTA_YAW,DELTA_PITCH) and (targetAngularVelocityYaw,targetAngularVelocityPitch); unknown when either norm < 1e-6",
    "targetRadialSpeed": "DISTANCE_TO_TARGET[t] - DISTANCE_TO_TARGET[t-1] when sameTarget(t)",
    "targetSpeed": "sqrt(TARGET_VELOCITY_X^2 + TARGET_VELOCITY_Y^2 + TARGET_VELOCITY_Z^2)",
    "targetAngularRadius": "degrees(atan2(0.5 * max(TARGET_MAX_X-TARGET_MIN_X, TARGET_MAX_Z-TARGET_MIN_Z), DISTANCE_TO_TARGET)) when DISTANCE_TO_TARGET > 1e-6",
    "aimErrorRatio": "AIM_ERROR_TOTAL / targetAngularRadius when targetAngularRadius > 1e-6",
    "playerSpeedHorizontal": "sqrt(VELOCITY_X^2 + VELOCITY_Z^2)",
    "sameTarget(t)": "t > 0 within the window AND TARGET_PRESENT[t]=1 AND TARGET_PRESENT[t-1]=1 AND TARGET_ENTITY_ID[t]=TARGET_ENTITY_ID[t-1] AND TARGET_SWITCH[t]=0 AND SEGMENT_START[t]=0",
    "TICKS_SINCE_TARGET_SWITCH": "raw field, but the -1 sentinel written when no target is tracked counts as unknown; the known value is then transformed with log1p before clipping",
    "aimErrorFrame(t-1)": "e = (wrap180(YAW[t-1] - TARGET_YAW[t-1]), PITCH[t-1] - TARGET_PITCH[t-1]), the aim error the player's rotation d = (DELTA_YAW[t], DELTA_PITCH[t]) responds to; usable when sameTarget(t) and |e| >= 1 degree",
    "rotationCorrectionGain": "-(d . e) / |e|^2 over aimErrorFrame(t-1): the fraction of last sample's aim error the rotation removed. A smoothing aim assist (yaw += (target - yaw) * k) holds it near k; a hand does not",
    "rotationOffAxis": "(d_yaw * e_pitch - d_pitch * e_yaw) / |e|^2 over aimErrorFrame(t-1): the rotation perpendicular to the error, in the same units. Assisted rotation runs straight at the target; yaw-odd"
  },
  "windows": {
    "attack": "anchored on a sample whose ATTACK=1; attackBefore samples before it, the attack sample, attackAfter samples after it. Complete tick ids only, no segment boundary after index 0.",
    "continuous": "the last sequenceLength consecutive samples with no segment boundary after index 0."
  },
  "heads": [
    "overall",
    "aimAssist",
    "killAura",
    "triggerBot"
  ],
  "requiredHeads": [
    "overall",
    "aimAssist"
  ],
  "transforms": {
    "none": "value used as recorded",
    "log1p": "natural log(1 + x), defined for x >= 0; unknown stays unknown and a negative input is unknown"
  },
  "versionHistory": {
    "1": "initial contract",
    "2": "TICKS_SINCE_TARGET_SWITCH changed from a raw sample count clipped at 200 to log1p(samples) clipped at 12. At the old bound the channel was constant for roughly three quarters of sampled windows (p50 = p99 = max = 200), so the clip discarded the dominant regime rather than a tail. log1p keeps full resolution in the first samples after a target switch, where the signal is, and compresses the long tail instead of erasing it. Bundles built for version 1 are rejected: the channel means something different now.",
    "3": "ROTATION_CORRECTION_GAIN and ROTATION_OFF_AXIS added after AIM_ERROR_RATIO: the player's rotation expressed in the frame of the previous aim error. Derived from raw fields that already existed, so raw schema 1 recordings are unchanged and usable; bundles built for schema 2 must be retrained."
  },
